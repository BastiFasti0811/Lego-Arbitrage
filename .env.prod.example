# Copy to .env.prod on the Hetzner server and keep the real values out of git.
# Example deploy:
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

COMPOSE_PROJECT_NAME=lego-arbitrage
DATA_ROOT=/mnt/HC_Volume_105179687/lego-arbitrage

POSTGRES_DB=lego_arbitrage
POSTGRES_USER=lego
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Backups (scripts/backup-db.sh) ──────────────────────────
# Where nightly pg_dump archives are written. Defaults to ${DATA_ROOT}/backups.
# NOTE: ${DATA_ROOT} lives on the Hetzner block volume, which is NOT in Hetzner's
# automatic backups — set BACKUP_REMOTE for a true off-site copy.
# BACKUP_DIR=/mnt/HC_Volume_105179687/lego-arbitrage/backups
# Number of dumps to retain before the oldest are pruned.
BACKUP_KEEP=14
# Optional off-site destination. If set, each dump is copied here after creation.
# Examples: an rclone remote "hetzner-box:lego-backups" (requires rclone configured),
# or leave empty to keep backups local-only.
# BACKUP_REMOTE=
