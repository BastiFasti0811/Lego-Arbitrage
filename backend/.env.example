# ═══════════════════════════════════════════════════════
# LEGO Arbitrage System — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lego:lego_secret@postgres:5432/lego_arbitrage
DATABASE_URL_SYNC=postgresql+psycopg://lego:lego_secret@postgres:5432/lego_arbitrage

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scraper ──────────────────────────────────────────
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
# Optional: Bright Data or other proxy
# PROXY_URL=http://user:pass@proxy.brightdata.com:22225
USE_STEALTH_MODE=true

# ── KI (Foto-Analyse + Anzeigentexte) ────────────────
# Key anlegen unter console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
AI_MONTHLY_BUDGET_EUR=100.0

# ── Telegram Notifications ───────────────────────────
# Create bot via @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789
# Deal-Alert-Knoepfe "Gekauft"/"Abgelehnt": die API holt Klicks per getUpdates
# ab. Auf false, wenn ein anderer Dienst denselben Bot abfragt (sonst 409).
# TELEGRAM_CALLBACK_POLLING=true
# Adresse, unter der das Handy die App erreicht; ohne sie fehlt im Alert der
# Knopf "Im Checker". Auch in den Dashboard-Einstellungen setzbar.
# APP_PUBLIC_URL=http://victus.<tailnet>.ts.net/lego

# ── Email Notifications ─────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=app_password_here
# NOTIFICATION_EMAIL=your@email.com

# ── Dashboard Auth ────────────────────────────────────
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Sessions liegen in Redis (REDIS_URL). Ohne Redis ist kein Login moeglich.
# Cookie-Pfad: lokal "/", in Prod unter /lego zwingend SESSION_COOKIE_PATH=/lego,
# sonst geht das Session-Cookie an jede andere App auf demselben Host.
SESSION_COOKIE_PATH=/
# Fremde Origins, die die API mit Cookie aufrufen und schreiben duerfen
# (CORS + CSRF-Guard), kommagetrennt. Leer lassen: Prod und der Vite-Dev-Server
# laufen same-origin. Schreibende /api-Aufrufe aus anderen Origins -> 403.
CORS_ALLOWED_ORIGINS=

# ── General ──────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
# Das Schema legt ausschliesslich Alembic an (scripts/deploy-prod.sh fuehrt
# `alembic upgrade head` aus). true wuerde Tabellen per create_all am Alembic-
# Stand vorbei anlegen; nur der lokale Dev-Stack (docker-compose.yml) setzt das.
AUTO_CREATE_TABLES_ON_STARTUP=false
# Session-Cookie nur ueber HTTPS senden. Ausnahme: Prod auf victus laeuft
# (Stand 20.10.2026) noch ohne HTTPS (Caddy nur :80) und braucht dort false,
# sonst ist kein Login moeglich. Lokal setzt docker-compose.yml false.
SESSION_COOKIE_SECURE=true
MEDIA_ROOT=data
INVENTORY_PHOTO_MAX_COUNT=8
INVENTORY_PHOTO_MAX_BYTES=8388608
INVENTORY_PHOTO_MAX_DIMENSION=1600
INVENTORY_PHOTO_JPEG_QUALITY=82
