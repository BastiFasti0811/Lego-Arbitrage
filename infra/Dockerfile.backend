FROM python:3.12-slim

WORKDIR /app

# System dependencies for Playwright & lxml
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies. Only pyproject.toml is in the context here, so
# the lego-arbitrage dist ends up metadata-only and this large layer stays
# cacheable; app.* is imported from the working tree copied below, never from
# site-packages (alembic.ini's prepend_sys_path relies on this).
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .[dev]

# Install Playwright browsers
RUN playwright install chromium && \
    playwright install-deps chromium

# Copy application code
COPY . .

# Git commit of this build, reported by /health as "version". Declared after
# the dependency layers so a new commit only rebuilds this last layer.
# scripts/deploy-prod.sh passes it via docker-compose.prod.yml; local builds
# leave it empty and /health falls back to app_version.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA}

# Default: run the API
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
